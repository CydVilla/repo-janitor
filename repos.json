{
  "repos": [
    {
      "repo": "CydVilla/trend-cart",
      "links": {
        "enabled": true,
        "ignoreUrlPatterns": [
          "amazon\\.",
          "localhost",
          "127\\.0\\.0\\.1",
          "/xrpc/",
          "api\\.resend\\.com",
          "your-app\\.",
          "trend-cart-[a-z0-9]+\\.herokuapp\\.com"
        ]
      },
      "deadCode": {
        "enabled": true,
        "openPRs": true,
        "verifyCommands": [
          "pnpm install --frozen-lockfile",
          "pnpm --filter @trendcart/db exec prisma generate",
          "pnpm -r typecheck",
          "pnpm lint"
        ]
      }
    }
  ]
}